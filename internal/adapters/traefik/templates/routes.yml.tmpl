# generated by multiversectl, regenerated on every start
services:
{{- range .Services}}
  {{.Name}}:
{{- if .Unpublish}}
    ports: !reset []
{{- end}}
{{- if .Env}}
    # Asked for with multiverse.env.* labels. This fragment is merged last, so
    # these win over the service's own environment and any env_file.
    environment:
{{- range .Env}}
      {{.Key}}: {{q .Value}}
{{- end}}
{{- end}}
{{- if .Labels}}
    labels:
{{- range .Labels}}
      {{.Key}}: {{q .Value}}
{{- end}}
    networks: [default{{range .Networks}}, {{.}}{{end}}]
{{- end}}
{{- end}}
{{- if .Networks}}
networks:
{{- range .Networks}}
  {{.}}:
    external: true
{{- end}}
{{- end}}
