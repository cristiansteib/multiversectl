# generated by multiversectl, regenerated on every start
services:
  traefik:
    # Pinned: older 3.x clients negotiate a docker API version that Docker 29+ refuses, which makes the proxy register zero routes while looking healthy.
    image: traefik:v3.7.16
    restart: unless-stopped
    command:
      - --providers.docker=true
      - --providers.docker.exposedbydefault=false
      - --providers.docker.network={{.Network}}
{{- range .Entrypoints}}
      - --entrypoints.{{.Name}}.address=:{{.Port}}
{{- end}}
    ports:
{{- range $.Entrypoints}}
      # Published on {{$.Bind}}: the loopback address is what keeps universes
      # off the network when the workspace asks to stay local.
      - "{{$.Bind}}:{{.Port}}:{{.Port}}"
{{- end}}
    volumes:
      - {{.Socket}}:/var/run/docker.sock:ro
    networks: [{{.Network}}]
networks:
  {{.Network}}:
    external: true
