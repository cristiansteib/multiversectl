      <rect class="d-box" x="262" y="386" width="206" height="44" rx="8"/>
      <text class="d-t" x="365" y="415" text-anchor="middle">universe.yaml</text>
      <rect class="d-box" x="480" y="386" width="206" height="44" rx="8"/>
      <text class="d-t" x="583" y="415" text-anchor="middle">its hostnames</text>

      <rect class="d-tint-off" x="20" y="460" width="680" height="156" rx="12"/>
      <text class="d-h" x="44" y="502">Rewritten on every start</text>
      <text class="d-m" x="44" y="532">generated beside your checkouts; safe to delete</text>
      <rect class="d-box" x="44" y="552" width="210" height="44" rx="8"/>
      <text class="d-t" x="149" y="581" text-anchor="middle">routes fragment</text>
