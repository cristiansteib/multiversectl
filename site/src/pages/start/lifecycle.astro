---
import Page from '../../layouts/Page.astro';
---

<Page path="start/lifecycle">
<!-- walkthrough:start -->
<section id="walkthrough">
  <h2 id="walkthrough"><a href="#walkthrough">Drive it yourself</a></h2>
  <p>One multiverse of three repositories &mdash; <code>ui</code> (react, hot reload),
    <code>k8s-manifest</code> (nothing to run) and <code>api</code> (<code>http</code>,
    <code>db</code>, <code>redis</code>) &mdash; run twice. The boxes are drawn from the
    start; what they hold is made by the commands. Press <kbd>Enter</kbd>, or use
    <strong>run</strong>, to run the command waiting at the prompt.</p>
<style is:global>
/* @embed:start — everything below is what the docs page needs */
/* The page it lives on drops its "on this page" column (notoc in nav.yaml), so
   the diagram has the width without reaching over anything. Below that it
   scrolls sideways rather than shrinking its labels to nothing. */
#walkthrough .term,#walkthrough figure,#walkthrough .legend{max-width:none}
#walkthrough figure{overflow-x:auto}
#walkthrough .scene{min-width:58rem}
.now{margin:0 0 12px;font-size:.9375rem;color:var(--text);min-height:3.2em;max-width:100ch}
.now b{color:var(--head);font-family:var(--mono);font-weight:600}

/* ---- the shell, above the drawing ------------------------------------
   A terminal in both themes, so its colours are literal. The command that is
   running is pinned at the top and only its output moves, in a three-line
   window that scrolls; the controls sit in a footer of their own so nothing
   is ever covered. */
.term{position:relative;border:1px solid var(--line);border-bottom:0;
  border-radius:10px 10px 0 0;background:#0d1016;overflow:hidden}
.term-bar{display:flex;align-items:center;gap:8px;padding:9px 16px;
  border-bottom:1px solid #1d2432;font:.75rem var(--mono);color:#7c8699}
.term-bar i{width:9px;height:9px;border-radius:50%;background:#2f3647;display:block}
.term-bar span{margin-left:6px}
.term pre{margin:0;font:.8125rem/1.62 var(--mono);color:#c7d0e0;background:none;border:0;
  white-space:pre}
.term-cmd{padding:12px 16px 2px;min-height:calc(1.62em + 14px);overflow-x:auto}
.term pre#shell{padding:2px 16px 12px;height:calc(3 * 1.62em + 14px);
  overflow-y:auto;overflow-x:auto;overscroll-behavior:contain;
  scrollbar-width:thin;scrollbar-color:#2f3647 transparent}
#shell::-webkit-scrollbar{width:9px;height:9px}
#shell::-webkit-scrollbar-thumb{background:#2f3647;border-radius:5px}
#shell::-webkit-scrollbar-thumb:hover{background:#3d465c}
#shell::-webkit-scrollbar-track{background:transparent}
#shell:focus-visible{outline:2px solid #7cc5f0;outline-offset:-2px}
.term .pr{color:#f0b45f;user-select:none}
.term .ok{color:#86cf7a}
.term .in{color:#7cc5f0}
.term .wa{color:#f0b45f}
.term .a{color:#7cc5f0}
.term .d{color:#7c8699}
.term .cur{color:#f0b45f;animation:blink 1.1s steps(2,end) infinite}
/* Said beside the command it is waiting on, with the dots doing the waiting. */
.term .press{color:#7c8699;margin-left:16px;animation:pressPulse 1.8s ease-in-out infinite}
.term .press::after{content:"";animation:pressDots 1.8s steps(1,end) infinite}
@keyframes pressDots{0%{content:""}25%{content:"."}50%{content:".."}75%{content:"..."}}
@keyframes pressPulse{0%,100%{opacity:.5}50%{opacity:1}}
@keyframes blink{50%{opacity:0}}
@media (prefers-reduced-motion:reduce){.term .cur,.term .press,.term .press::after{animation:none}}
/* the controls, in the shell's own footer at the bottom right */
.term-float{display:flex;align-items:center;justify-content:flex-end;gap:8px;
  padding:8px 14px;border-top:1px solid #1d2432}
.term-float button{min-height:32px;padding:6px 12px;border-color:#262d3b;background:#181d27;
  color:#c7d0e0}
.term-float button:hover:not(:disabled){border-color:#7c8699;color:#edf1f8}
.term-float button:disabled{opacity:.4;cursor:default}
.term-float #run{border-color:#f0b45f;color:#f0b45f}
.term-float #run:hover:not(:disabled){background:#f0b45f;color:#1a1206}
.term-float button[aria-pressed=true]{background:#f0b45f;border-color:#f0b45f;color:#1a1206}
.term-hint{font:.75rem var(--mono);color:#7c8699;margin-right:4px}
.term-hint kbd{font:inherit;color:#f0b45f;border:1px solid #2f3647;border-radius:4px;padding:1px 5px}
@media (max-width:760px){.term pre{font-size:.6875rem}}

#walkthrough figure{margin:0 0 14px}
.scene{width:100%;height:auto;display:block;background:var(--sunk);
  border:1px solid var(--line);border-radius:0 0 10px 10px}
#walkthrough figcaption{font-size:.875rem;color:var(--muted);margin-top:12px;max-width:84ch}

/* ---- scene vocabulary ---------------------------------------------------
   The drawing rests in black and white. A box or a line takes its own colour
   only in the moment it arrives, and fades back to grey over a second, so
   colour means one thing and one thing only: this is what just changed.
   Text keeps its colours, because a branch and an address are not boxes. */
/* Three states, and colour means exactly one of them.
   The main boxes are always drawn — the multiverse, each universe, each
   `in docker`, the proxy and the client. What they hold is not drawn at all
   until a command makes it, and goes again when one destroys it. So there are
   two looks, not three:
   idle  — it exists; nothing about it is running. Solid outline, one grey.
   live  — in action. It fills with its own colour, and loses it again the
           moment it stops.
   Fills are tints over whatever ground the page has, never an opaque colour,
   so a filled box can never wash out the text inside it. */
.place,.place-keep,.proj,.card rect,.wire,.live,.head,.head-live,.bar{
  transition:fill .5s ease, stroke .5s ease, opacity .5s ease, stroke-dasharray 0s}
.card text,.t-h,.t-a,.t-br{transition:fill .35s ease}

/* idle: the default */
.place,.place-keep,.proj,.card rect{fill:none;stroke:#5c6678;stroke-width:1.5}
.card.gen rect{stroke-dasharray:5 4;stroke:#49536a}
.wire,.live{fill:none;stroke:#49536a;stroke-width:1.5}
.live{stroke-width:2}
.head,.head-live{fill:#49536a;stroke:none}
.bar{fill:#5c6678;stroke:none;opacity:.5}
.t-h,.t-a,.t-br,.card text{fill:#6b7488}

/* live: in action */
[data-state=live] .place,.place[data-state=live]{stroke:var(--text)}
[data-state=live] .place-keep,.place-keep[data-state=live]{stroke:var(--addr);
  fill:color-mix(in srgb,var(--addr) 7%,transparent)}
[data-state=live] .proj,.proj[data-state=live]{stroke:var(--num);
  fill:color-mix(in srgb,var(--num) 6%,transparent)}
.card[data-state=live] rect{stroke:var(--num);fill:color-mix(in srgb,var(--num) 12%,transparent)}
.card.run[data-state=live] rect{stroke:var(--ok);fill:color-mix(in srgb,var(--ok) 14%,transparent)}
.card.gen[data-state=live] rect{stroke:var(--muted);fill:none}
[data-state=live] .wire{stroke:var(--num)}
[data-state=live] .head{fill:var(--num)}
[data-state=live] .live{stroke:var(--addr)}
[data-state=live] .head-live{fill:var(--addr)}
[data-state=live] .bar{fill:var(--num);opacity:1}
[data-state=live] .t-h{fill:var(--head)}
[data-state=live] .t-a{fill:var(--num)}
[data-state=live] .t-br{fill:var(--num)}
.card[data-state=live] text{fill:var(--text)}

/* Fonts only. Which colour a label takes is the state block's business above,
   so a name cannot go on carrying a colour after the thing it names has
   stopped — which is what kept the docker content coloured when it was not. */
.card text{font:12px var(--mono)}
.card.gen text{font:11px var(--mono)}
.t-h{font:600 13px var(--sans)}
.t-m{font:11px var(--mono);fill:var(--muted)}
.t-a{font:600 12px var(--mono)}
.t-br{font:600 11px var(--mono)}
/* The request's own address and token: they exist only while it is in flight. */
.t-ad{font:600 12px var(--mono);fill:var(--addr)}
.token circle{fill:var(--addr)}
.bar.fired{fill:var(--num);opacity:1}
.tag{font:600 10px var(--mono);fill:var(--ok)}

.ico{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
.ico .solid{fill:currentColor;stroke:none}
/* An icon is grey too until the thing it belongs to is in action. */
.c-muted,.c-num,.c-addr,.c-ok{color:#6b7488}
[data-state=live] .c-muted{color:var(--muted)}
[data-state=live] .c-num{color:var(--num)}
[data-state=live] .c-addr{color:var(--addr)}
[data-state=live] .c-ok{color:var(--ok)}

/* ---- the manifest the multiverse is grouped by ------------------------ */
.clickable{cursor:pointer}
/* The affordance is a dashed outline at rest like everything else; it takes
   its colour when you reach for it. */
.clickable rect{stroke-dasharray:6 3}
.clickable:hover rect,.clickable:focus-visible rect{stroke:var(--addr);stroke-width:2.5;
  stroke-dasharray:none}
.clickable:focus-visible{outline:none}
.hint{fill:var(--addr)}

.t-note{font-size:.8125rem;color:var(--muted)}
.t-note code{font-family:var(--mono);font-size:.9em}

/* The manifest opens as a drawer over a scrim: the diagram stays readable
   behind it, which is the point of showing the file at all. Kept in the DOM
   and hidden with `visibility`, so it has a state to transition from. */
.scrim{position:fixed;inset:0;z-index:40;
  background:color-mix(in srgb,var(--ground) 58%,transparent);
  backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px);
  opacity:0;transition:opacity .24s ease}
.scrim.open{opacity:1}
.drawer{position:fixed;top:0;right:0;bottom:0;z-index:41;width:min(46rem,96vw);
  display:flex;flex-direction:column;
  background:color-mix(in srgb,var(--raised) 92%,transparent);
  backdrop-filter:blur(14px) saturate(1.2);-webkit-backdrop-filter:blur(14px) saturate(1.2);
  border-left:1px solid var(--addr);
  box-shadow:-28px 0 70px -34px rgb(0 0 0/.75);
  transform:translateX(100%);transition:transform .26s cubic-bezier(.2,.7,.3,1)}
.drawer.open{transform:none}
@supports not (backdrop-filter:blur(2px)){
  .scrim{background:color-mix(in srgb,var(--ground) 80%,transparent)}
  .drawer{background:var(--raised)}
}
@media (prefers-reduced-motion:reduce){.scrim,.drawer{transition:none}}
.drawer-h{display:flex;align-items:center;gap:12px;padding:16px 20px;border-bottom:1px solid var(--line)}
.drawer-h .drawer-title{margin:0;font:600 1rem/1 var(--mono);color:var(--head)}
.drawer-kind{font:.8125rem var(--mono);color:var(--muted)}
.drawer-h button{margin-left:auto;padding:6px 14px;min-height:32px}
.drawer-b{padding:18px 20px 32px;overflow:auto;overscroll-behavior:contain}
.drawer-b pre{margin:0 0 16px;padding:16px;background:var(--sunk);border:1px solid var(--line);
  border-radius:8px;overflow-x:auto;font:.8125rem/1.7 var(--mono);color:var(--text)}
.drawer-b pre .k{color:var(--addr)}
.drawer-b pre .c{color:var(--muted)}
/* The labels are the only multiversectl-specific lines in a compose file, so
   the mark hugs the key itself rather than banding the whole row. */
.drawer-b pre mark.lbl{background:color-mix(in srgb,var(--num) 20%,transparent);
  color:var(--num);font-weight:600;border-radius:4px;padding:1px 4px;margin:0 -3px;
  box-decoration-break:clone;-webkit-box-decoration-break:clone}
#file-legend{margin:-4px 0 16px;font-size:.8125rem;color:var(--muted);
  display:flex;align-items:center;gap:8px}
#file-legend mark.lbl{background:color-mix(in srgb,var(--num) 20%,transparent);
  color:var(--num);font:600 .75rem var(--mono);border-radius:4px;padding:2px 6px}
.drawer-b p{margin:0 0 14px;font-size:.875rem;line-height:1.6;color:var(--muted);max-width:60ch}
.drawer-b p:last-child{margin-bottom:0}

/* The repository as a folder: a tree you click down the left, the file it
   opens on the right. */
.fileview{display:grid;grid-template-columns:minmax(10rem,13rem) minmax(0,1fr);
  gap:0;border:1px solid var(--line);border-radius:9px;overflow:hidden;margin:0 0 16px}
.tree{list-style:none;margin:0;padding:10px 6px;background:var(--sunk);
  border-right:1px solid var(--line);font:.8125rem/1.7 var(--mono)}
.tree li{padding-left:calc(var(--d) * 12px)}
.tree span{display:block;padding:2px 8px;color:var(--muted)}
.tree span.dir{color:var(--text)}
.tree button{display:block;width:100%;text-align:left;padding:2px 8px;min-height:0;
  font:.8125rem/1.7 var(--mono);border:0;border-radius:5px;background:none;color:var(--addr)}
.tree button:hover{background:color-mix(in srgb,var(--addr) 14%,transparent);color:var(--head)}
.tree button[aria-current=true]{background:color-mix(in srgb,var(--addr) 18%,transparent);
  color:var(--head);font-weight:600}
.filebody{min-width:0;display:flex;flex-direction:column}
.filename{margin:0!important;padding:8px 14px;border-bottom:1px solid var(--line);
  font:600 .75rem var(--mono);color:var(--muted)}
.filebody pre{margin:0;border:0;border-radius:0;flex:1;min-width:0;width:100%}
@media (max-width:520px){.fileview{grid-template-columns:minmax(0,1fr)}
  .tree{border-right:0;border-bottom:1px solid var(--line)}}
.drawer-b code{font-family:var(--mono);font-size:.9em;color:var(--text)}
.drawer-lede{color:var(--text)!important}

.legend{display:flex;flex-wrap:wrap;gap:6px 20px;margin:14px 0 0;font-size:.8125rem;color:var(--muted)}
.sw{display:inline-block;width:.85em;height:.85em;margin-right:6px;border-radius:3px;
  border:1px solid currentcolor;vertical-align:-.05em}
.sw-addr{color:var(--addr);background:color-mix(in srgb,var(--addr) 22%,transparent)}
.sw-num{color:var(--num);background:color-mix(in srgb,var(--num) 22%,transparent)}
.sw-ok{color:var(--ok);background:color-mix(in srgb,var(--ok) 22%,transparent)}
.sw-off{color:var(--muted);background:color-mix(in srgb,var(--muted) 18%,transparent);border-style:dashed}
@media (max-width:760px){.sp{margin-left:0;width:100%}}
</style>
<p class="now" id="now" aria-live="polite"></p>

<div class="term">
  <div class="term-bar"><i></i><i></i><i></i><span>~/acme</span></div>
  <pre class="term-cmd" id="shell-cmd" aria-live="off"></pre>
  <pre id="shell" role="log" tabindex="0" aria-label="Output of the running command"></pre>
  <div class="term-float">
    <button id="run" type="button">&#8617; run</button>
    <button id="auto" type="button" aria-pressed="false"
            title="Play the whole walkthrough on its own">&#9654; auto</button>
  </div>
</div>

<figure>
<svg class="scene" id="scene" viewBox="0 0 1280 628" role="img"
     aria-label="Two universes of one multiverse. Three clones at the top feed a new transition into each universe. Each universe holds a worktree of ui, k8s-manifest and api on disk, plus a rendered config and a routing fragment per app; an up transition turns those into two compose projects in docker, each on a network of its own, holding the hot-reloading web service and the http, db and redis services with a postgres volume. k8s-manifest has no compose file, so nothing runs for it. The one shared proxy sits between the two universes and carries a browser request to ui-u1.example.test and to ui-u2.example.test. down and rm act on one universe and leave the other running.">
  <defs>
    <symbol id="i-git" viewBox="0 0 16 16"><circle cx="4" cy="4" r="2"/><circle cx="4" cy="12" r="2"/><circle cx="12" cy="5.5" r="2"/><path d="M4 6v4M6 12h2a4 4 0 004-4"/></symbol>
    <symbol id="i-folder" viewBox="0 0 16 16"><path d="M2 4.5h4l1.6 2H14v6.5a1 1 0 01-1 1H3a1 1 0 01-1-1v-8.5z"/></symbol>
    <symbol id="i-doc" viewBox="0 0 16 16"><path d="M4 2h5l3 3v9a1 1 0 01-1 1H4a1 1 0 01-1-1V3a1 1 0 011-1z"/><path d="M9 2v3h3M5.5 9h5M5.5 11.5h4"/></symbol>
    <symbol id="i-react" viewBox="0 0 16 16"><circle class="solid" cx="8" cy="8" r="1.5"/><ellipse cx="8" cy="8" rx="7" ry="2.7"/><ellipse cx="8" cy="8" rx="7" ry="2.7" transform="rotate(60 8 8)"/><ellipse cx="8" cy="8" rx="7" ry="2.7" transform="rotate(120 8 8)"/></symbol>
    <symbol id="i-k8s" viewBox="0 0 16 16"><path d="M8 1.6l5.6 3.2v6.4L8 14.4 2.4 11.2V4.8z"/><circle cx="8" cy="8" r="2"/></symbol>
    <symbol id="i-server" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="4.4" rx="1.2"/><rect x="2" y="8.6" width="12" height="4.4" rx="1.2"/><circle class="solid" cx="4.6" cy="5.2" r=".8"/><circle class="solid" cx="4.6" cy="10.8" r=".8"/></symbol>
    <symbol id="i-db" viewBox="0 0 16 16"><ellipse cx="8" cy="4" rx="5.4" ry="2.1"/><path d="M2.6 4v8c0 1.2 2.4 2.1 5.4 2.1s5.4-.9 5.4-2.1V4"/><path d="M2.6 8c0 1.2 2.4 2.1 5.4 2.1s5.4-.9 5.4-2.1"/></symbol>
    <symbol id="i-bolt" viewBox="0 0 16 16"><path d="M9.2 1.6L3.6 9H7.8l-1 5.4L12.4 7H8.2z"/></symbol>
    <symbol id="i-box" viewBox="0 0 16 16"><path d="M8 1.8l6 3v6.4l-6 3-6-3V4.8z"/><path d="M2 4.8l6 3 6-3M8 7.8v6.4"/></symbol>
    <symbol id="i-person" viewBox="0 0 16 16"><circle cx="8" cy="5" r="2.6"/><path d="M2.8 14a5.2 5.2 0 0110.4 0"/></symbol>
    <symbol id="i-bot" viewBox="0 0 16 16"><rect x="2.5" y="5" width="11" height="8.5" rx="2.2"/><path d="M8 2v3"/><circle class="solid" cx="6" cy="9" r="1"/><circle class="solid" cx="10" cy="9" r="1"/><path d="M1 8.5v2.5M15 8.5v2.5"/></symbol>
    <symbol id="i-net" viewBox="0 0 16 16"><circle cx="8" cy="3" r="1.8"/><circle cx="3" cy="12.6" r="1.8"/><circle cx="13" cy="12.6" r="1.8"/><path d="M8 4.8v3.6M7.3 8.8l-3 2.4M8.7 8.8l3 2.4"/></symbol>
    <symbol id="i-vol" viewBox="0 0 16 16"><rect x="2.4" y="2.4" width="11.2" height="11.2" rx="1.4"/><path d="M5.6 2.4v4h4.8v-4M5.6 13.6v-3.4h4.8v3.4"/></symbol>
    <symbol id="i-browser" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="1.4"/><path d="M2 6.4h12"/><circle class="solid" cx="4.3" cy="4.7" r=".7"/></symbol>
    <symbol id="i-proxy" viewBox="0 0 16 16"><path d="M1.6 8h4.8M6.4 8l2.6-2.8M6.4 8l2.6 2.8M9.4 5.2h5M9.4 10.8h5"/></symbol>
    <symbol id="i-reload" viewBox="0 0 16 16"><path d="M13.6 8a5.6 5.6 0 11-1.9-4.2"/><path d="M14 2.2v3.2h-3.2"/></symbol>
  </defs>

  <!-- ===== the multiverse and its repositories, one column ===== -->
  <rect id="clone-box" class="place-keep" x="24" y="60" width="280" height="410" rx="10" data-state="idle"/>
  <text class="t-h" x="44" y="88">the multiverse</text>
  <g id="manifest-card" class="card plain clickable" data-state="idle" role="button" tabindex="0"
     aria-expanded="false" aria-controls="file-panel" data-file="manifest">
    <rect x="40" y="100" width="248" height="54" rx="8"/>
    <use class="ico c-addr" href="#i-doc" x="52" y="118" width="16" height="16"/>
    <text x="76" y="118">multiverse.yaml</text>
    <text class="t-m" x="76" y="138">kind: Multiverse</text>
  </g>
  <text class="t-m hint" id="manifest-hint" x="44" y="172">click a card to read its files</text>

  <rect class="place" x="40" y="186" width="248" height="170" rx="8"/>
  <text class="t-m" x="52" y="206">spec.repos &middot; ~/acme/</text>
  <g class="card plain clickable" id="clone-ui" data-state="idle" role="button" tabindex="0"
     aria-controls="file-panel" data-file="ui">
    <rect x="52" y="216" width="224" height="38" rx="7"/>
    <use class="ico c-muted" href="#i-git" x="64" y="227" width="16" height="16"/>
    <text x="90" y="240">ui</text>
    <text class="t-m" x="264" y="240" text-anchor="end">react</text>
  </g>
  <g class="card plain clickable" id="clone-api" data-state="idle" role="button" tabindex="0"
     aria-controls="file-panel" data-file="api">
    <rect x="52" y="262" width="224" height="38" rx="7"/>
    <use class="ico c-muted" href="#i-git" x="64" y="273" width="16" height="16"/>
    <text x="90" y="286">api</text>
    <text class="t-m" x="264" y="286" text-anchor="end">http db redis</text>
  </g>
  <g class="card plain clickable" id="clone-k8s" data-state="idle" role="button" tabindex="0"
     aria-controls="file-panel" data-file="k8s-manifest">
    <rect x="52" y="308" width="224" height="38" rx="7"/>
    <use class="ico c-muted" href="#i-git" x="64" y="319" width="16" height="16"/>
    <text x="90" y="332">k8s-manifest</text>
    <text class="t-m" x="264" y="332" text-anchor="end">no compose</text>
  </g>

  <rect class="place" x="40" y="372" width="248" height="56" rx="8" stroke-dasharray="5 4" opacity=".5"/>
  <text class="t-m" x="52" y="394" opacity=".6">another multiverse</text>
  <text class="t-m" x="52" y="414" opacity=".6">its own repos, same proxy</text>
  <text class="t-m" x="44" y="452">cloned once, never touched</text>

  <g id="new-trunk"><path class="wire" d="M288 271H312V30H1036"/></g>

  <!-- ======================= universe 1 ======================= -->
  <g id="u1-new" data-state="idle">
    <text class="t-a" x="586" y="48">new</text>
    <path class="wire" d="M560 30V36M560 45V48"/>
